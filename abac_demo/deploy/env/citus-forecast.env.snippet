# Dán vào cuối /etc/abac-app.env (hoặc: sudo bash -c 'cat deploy/env/citus-forecast.env.snippet >> /etc/abac-app.env')
# Ngoại suy dòng Citus Bảng 11 từ kết quả partition — restart abac-demo sau khi sửa

ABAC_CITUS_TPS_FACTOR_LO=1.5
ABAC_CITUS_TPS_FACTOR_HI=2.0
ABAC_CITUS_P95_FACTOR_LO=0.60
ABAC_CITUS_P95_FACTOR_HI=0.70
