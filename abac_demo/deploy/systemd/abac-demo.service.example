[Unit]
Description=ABAC Demo (Gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/abac/abac_demo
EnvironmentFile=/etc/abac-app.env
Environment="ABAC_TRUST_PROXY=1"
# Benchmark PDP có thể chạy vài phút — timeout mặc định 30s sẽ cắt request
ExecStart=/var/www/abac/abac_demo/venv/bin/gunicorn -w 2 -b 127.0.0.1:8000 --timeout 900 app:app
Restart=always

[Install]
WantedBy=multi-user.target
