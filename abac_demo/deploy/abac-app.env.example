# Mẫu biến môi trường ABAC Demo — copy/sửa thành /etc/abac-app.env trên VPS
# systemd abac-demo.service: EnvironmentFile=/etc/abac-app.env
# Sau khi sửa: sudo systemctl restart abac-demo

# --- PostgreSQL (bắt buộc) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=abac_demo
DB_USER=abac_user
DB_PASSWORD=đổi-mật-khẩu-mạnh

# --- Bảo mật / proxy ---
ABAC_ADMIN_TOKEN=đổi-token-admin-mạnh
ABAC_TRUST_PROXY=1

# --- Hiệu năng PDP 3.2.2 (tuỳ chọn) ---
# ABAC_PERF_BATCHES=5
# ABAC_PERF_REQUESTS_PER_BATCH=1000
# ABAC_PERF_SEED_LIMIT=15 per hour
# ABAC_PERF_RUN_LIMIT=20 per hour

# --- Load test TPS/P95 3.2.3 (tuỳ chọn) ---
# ABAC_LOADTEST_DURATION_SEC=30
# ABAC_LOADTEST_WORKERS=4
# ABAC_LOADTEST_WARMUP=50
# ABAC_LOADTEST_RUN_LIMIT=10 per hour

# --- Ngoại suy Citus 2 node (dòng dự báo Bảng 11) ---
# Tính từ kết quả đo partition: TPS × [LO..HI], P95 × [LO..HI] (giảm latency)
# Mặc định trong code nếu không đặt: 1.5–2.0 TPS, 0.60–0.70 P95 (−30–40%)
ABAC_CITUS_TPS_FACTOR_LO=1.5
ABAC_CITUS_TPS_FACTOR_HI=2.0
ABAC_CITUS_P95_FACTOR_LO=0.60
ABAC_CITUS_P95_FACTOR_HI=0.70

# --- Khác (tuỳ chọn) ---
# ABAC_DEBUG_ERRORS=0
# ABAC_MAX_BODY_BYTES=65536
# ABAC_STATS_SINCE_DAYS=90
